#: .\mychatbot\templates\base\chatbox.html:15
msgid "University Assistant"
msgstr "Asistente Universitario"

#: .\mychatbot\templates\base\chatbox.html:20
#: .\mychatbot\templates\base\chatbox.html:64
msgid "Hello! Welcome to the NextGen university chatbot."
msgstr "¡Hola! Bienvenido al chatbot universitario NextGen."

#: .\mychatbot\templates\base\chatbox.html:21
msgid "Assistant:"
msgstr "Asistente:"

#: .\mychatbot\templates\base\chatbox.html:21
#: .\mychatbot\templates\base\chatbox.html:65
msgid "Are you already a student?"
msgstr "¿Ya eres estudiante?"

#: .\mychatbot\templates\base\chatbox.html:25
#: .\mychatbot\templates\base\chatbox.html:60
msgid "Yes"
msgstr "Sí"

#: .\mychatbot\templates\base\chatbox.html:28
#: .\mychatbot\templates\base\chatbox.html:61
msgid "No"
msgstr "No"

#: .\mychatbot\templates\base\chatbox.html:39
msgid "Email me this conversation"
msgstr "Enviarme esta conversación por correo"

#: .\mychatbot\templates\base\chatbox.html:42
msgid "Your email address"
msgstr "Tu dirección de correo electrónico"

#: .\mychatbot\templates\base\chatbox.html:45
msgid "Type your question..."
msgstr "Escribe tu pregunta..."

#: .\mychatbot\templates\base\chatbox.html:46
msgid "Send"
msgstr "Enviar"

#: .\mychatbot\templates\base\chatbox.html:58
msgid "Assistant"
msgstr "Asistente"

#: .\mychatbot\templates\base\chatbox.html:59
msgid "You"
msgstr "Tú"

#: .\mychatbot\templates\base\chatbox.html:66
msgid "What would you like to do?"
msgstr "¿Qué te gustaría hacer?"

#: .\mychatbot\templates\base\chatbox.html:67
msgid "What type of program are you interested in?"
msgstr "¿En qué tipo de programa estás interesado?"

#: .\mychatbot\templates\base\chatbox.html:68
msgid "Which undergraduate program interests you?"
msgstr "¿Qué programa de pregrado te interesa?"

#: .\mychatbot\templates\base\chatbox.html:69
msgid "Which graduate program interests you?"
msgstr "¿Qué programa de posgrado te interesa?"

#: .\mychatbot\templates\base\chatbox.html:70
msgid "Which online course interests you?"
msgstr "¿Qué curso en línea te interesa?"

#: .\mychatbot\templates\base\chatbox.html:71
msgid ""
"Please provide your email address and we will send your program resources."
msgstr "Por favor proporciona tu dirección de correo electrónico y te enviaremos los recursos de tu programa."

#: .\mychatbot\templates\base\chatbox.html:72
msgid ""
"Please use the message box below to describe your issue. Check the box to "
"receive a transcript of this conversation."
msgstr "Por favor usa el cuadro de mensaje a continuación para describir tu problema. Marca la casilla para recibir una transcripción de esta conversación."

#: .\mychatbot\templates\base\chatbox.html:73
msgid ""
"Thank you for your message. An administrator will contact you shortly. "
"Please ensure your email is correct to receive updates."
msgstr "Gracias por tu mensaje. Un administrador se comunicará contigo shortly. Asegúrate de que tu correo electrónico sea correcto para recibir actualizaciones."

#: .\mychatbot\templates\base\chatbox.html:74
msgid "Taking you to the"
msgstr "Llevándote a la"

#: .\mychatbot\templates\base\chatbox.html:75
msgid "page..."
msgstr "página..."

#: .\mychatbot\templates\base\chatbox.html:76
msgid "I'm interested in:"
msgstr "Estoy interesado en:"

#: .\mychatbot\templates\base\chatbox.html:79
msgid "Email me my program resources"
msgstr "Enviarme los recursos de mi programa por correo"

#: .\mychatbot\templates\base\chatbox.html:80
msgid "Contact Administrator"
msgstr "Contactar Administrador"

#: .\mychatbot\templates\base\chatbox.html:81
msgid "Undergraduate"
msgstr "Pregrado"

#: .\mychatbot\templates\base\chatbox.html:82
msgid "Graduate"
msgstr "Posgrado"

#: .\mychatbot\templates\base\chatbox.html:83
msgid "Online Courses"
msgstr "Cursos en Línea"

#: .\mychatbot\templates\base\chatbox.html:86
msgid "BSc in Computer Science"
