#: .\mychatbot\templates\base\chatbox.html:87
msgid "BA in Economics"
msgstr "Licenciatura en Economía"

#: .\mychatbot\templates\base\chatbox.html:88
msgid "MBA"
msgstr "MBA"

#: .\mychatbot\templates\base\chatbox.html:89
msgid "MDSc in Data Science"
msgstr "Maestría en Ciencia de Datos"

#: .\mychatbot\templates\base\chatbox.html:90
msgid "Web Development Bootcamp"
msgstr "Bootcamp de Desarrollo Web"

#: .\mychatbot\templates\base\chatbox.html:91
msgid "Introduction to AI"
msgstr "Introducción a la IA"

#: .\mychatbot\templates\base\chatbox.html:94
msgid "Yes, I am a student"
msgstr "Sí, soy estudiante"

#: .\mychatbot\templates\base\chatbox.html:95
msgid "No, I am not a student"
msgstr "No, no soy estudiante"

#: .\mychatbot\templates\base\chatbox.html:96
msgid "Undergraduate programs"
msgstr "Programas de pregrado"

#: .\mychatbot\templates\base\chatbox.html:97
msgid "Graduate programs"
msgstr "Programas de posgrado"

#: .\mychatbot\templates\base\chatbox.html:98
msgid "Online courses"
msgstr "Cursos en línea"

#: .\mychatbot\templates\base\chatbox.html:99
msgid "I want to contact an administrator"
msgstr "Quiero contactar a un administrador"

#: .\mychatbot\templates\base\chatbox.html:102
msgid "Transcript sent to your email!"
msgstr "¡Transcripción enviada a tu correo!"

#: .\mychatbot\templates\base\chatbox.html:103
msgid "Failed to send transcript."
msgstr "Error al enviar la transcripción."

#: .\mychatbot\templates\base\chatbox.html:104
msgid "Please include your email above to receive program resources"
msgstr "Por favor incluye tu correo electrónico arriba para recibir recursos del programa"

